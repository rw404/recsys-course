{
  "name": "recsys-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive adventure-mode vertical slice for a Recommender Systems course. WASD explorer, spatial progress interface.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run test:course && npm run test:foundry",
    "test:course": "esbuild logic.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/logic.test.mjs && node node_modules/.cache/logic.test.mjs",
    "test:foundry": "esbuild systemSimulator.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/systemSimulator.test.mjs && node node_modules/.cache/systemSimulator.test.mjs",
    "data:movielens": "node scripts/prepare-movielens-100k.mjs",
    "data:movietweetings": "node scripts/prepare-movietweetings-100k.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "@react-three/rapier": "^1.5.0",
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^0.468.0",
    "postprocessing": "^6.39.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright-core": "^1.49.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
